{
  "name": "qris-lab",
  "version": "0.1.0",
  "description": "Research tool for parsing, validating and comparing EMVCo/QRIS merchant-presented QR payloads",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "qris": "node dist/cli/index.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^15.1.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.7",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "bin": {
    "qris-lab": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
